print_verbose() dropped its variadic arguments, so verbose output printed
raw format strings (and -Wformat-security flagged it). Forward them.

--- a/src/tabletDriver.c
+++ b/src/tabletDriver.c
@@ -2,7 +2,9 @@
 #include <fcntl.h>
 #include <linux/uinput.h>
 
+#include <stdarg.h>
 #include <stdbool.h>
+#include <stdio.h>
 
 #include "argument_parser.h"
 #include "ssh.h"
@@ -16,7 +18,10 @@
 /* This function only prints if verbose is enabled */
 static inline void print_verbose(const char *format, ...) {
     if (verbose) {
-        printf(format);
+        va_list args;
+        va_start(args, format);
+        vprintf(format, args);
+        va_end(args);
     }
 }
 
