description="rmfakecloud reMarkable sync server"

command="/usr/bin/rmfakecloud"
command_user="rmfakecloud:rmfakecloud"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}/${RC_SVCNAME}.log"
directory="/var/lib/rmfakecloud"

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath -d -o rmfakecloud:rmfakecloud -m 0750 /var/lib/rmfakecloud "/var/log/${RC_SVCNAME}"
	if [ -r /etc/rmfakecloud.conf ]; then
		set -a
		. /etc/rmfakecloud.conf
		set +a
	fi
}
