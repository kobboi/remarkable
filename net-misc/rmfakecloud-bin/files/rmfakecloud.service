[Unit]
Description=rmfakecloud reMarkable sync server
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/rmfakecloud.conf
ExecStart=/usr/bin/rmfakecloud
User=rmfakecloud
Group=rmfakecloud
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/rmfakecloud

[Install]
WantedBy=multi-user.target
